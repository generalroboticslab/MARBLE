# Robot-specific calibration must be generated on hardware.
# Keep the intentional robot backup tracked so a board wipe is recoverable.
calibration.json
calibration.*.json
!calibration.robot-backup.json
config/calibration.json
config/calibration.*.json
!config/calibration.robot-backup.json

